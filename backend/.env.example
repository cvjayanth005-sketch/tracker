TRACKER_DB_PATH=./tracker.sqlite3
# Supabase Postgres account cloud state. When set, auth/session/state sync uses
# this database instead of local SQLite.
SUPABASE_DATABASE_URL=
FRONTEND_ORIGINS=http://localhost:5173,https://your-vercel-app.vercel.app
# Optional for Vercel preview deployments. Keep narrow if you set it.
FRONTEND_ORIGIN_REGEX=^https://your-vercel-project-[a-z0-9-]+\.vercel\.app$
GOOGLE_CLIENT_ID=your-google-oauth-web-client-id.apps.googleusercontent.com
AUTH_RATE_LIMIT=20
AUTH_RATE_WINDOW_SECONDS=900
# Per signed-in user, across food parse / coach note / coach chat / onboarding draft.
AI_RATE_LIMIT=40
AI_RATE_WINDOW_SECONDS=900
# Reject oversized cloud sync documents (bytes).
STATE_BODY_MAX_BYTES=2000000
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# OpenAPI UI. Leave unset in production.
TRACKER_ENABLE_DOCS=
# Session lifetime in days (1–90). Tokens are hashed at rest.
SESSION_DAYS=30
# Tests only. Ignored whenever GOOGLE_CLIENT_ID is set.
TRACKER_ALLOW_UNVERIFIED_GOOGLE=
# Keep real keys in backend/.env or your shell, never in git.
